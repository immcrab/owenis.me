rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// The public site only ever creates documents. Reading, updating a
// status, or deleting is restricted to the Google accounts listed in
// isAdmin() below — edit that list to add or remove admins.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'imcrabfr@gmail.com'
           ];
    }

    match /requests/{requestId} {
      allow read, delete: if isAdmin();

      // Admins may only ever change the status field, never the
      // submitted request data itself.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow create: if
        request.resource.data.keys().hasOnly([
          'handle', 'projectId', 'contactEmail', 'dnsRecords',
          'note', 'status', 'userAgent', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'handle', 'projectId', 'contactEmail', 'dnsRecords',
          'note', 'status', 'createdAt'
        ])
        && request.resource.data.handle is string
        && request.resource.data.handle.size() > 0
        && request.resource.data.handle.size() <= 32
        && request.resource.data.handle.matches('^[a-z0-9]([a-z0-9-]*[a-z0-9])?$')
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.projectId.size() <= 120
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 200
        && request.resource.data.contactEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.dnsRecords is string
        && request.resource.data.dnsRecords.size() >= 20
        && request.resource.data.dnsRecords.size() <= 5000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
