# Firebase client config — from Firebase console → Project settings → General → Your apps.
# These are all public/client-safe values (not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at local Firebase Emulators (see README).
VITE_USE_EMULATORS=false

# Cloudflare Worker base URL (see worker/) — the only place the Groq API key
# lives. Local dev default matches `wrangler dev`'s default port.
VITE_WORKER_URL=http://127.0.0.1:8787

# Google OAuth 2.0 Web Client ID (see README "Authorized domains" section).
# Optional — without it, the "Connect Google to manage domains" feature is
# simply hidden; everything else works fine without this.
VITE_GOOGLE_OAUTH_CLIENT_ID=
